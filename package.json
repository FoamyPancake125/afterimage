{
  "name": "afterimage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Absence intelligence for the connected home. Ring observations, Alexa+ reasoning, Fire TV reconstruction.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false || tsc -b",
    "engine:test": "node --experimental-strip-types --no-warnings src/engine/selftest.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
